{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django Debug",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "runserver",
                "0.0.0.0:8000"
            ],
            "django": true,
            "justMyCode": false,
            "console": "integratedTerminal",
            "env": {
                "DJANGO_SETTINGS_MODULE": "LorraineShop.settings"
            },
            "python": "${workspaceFolder}/venv/bin/python"
        }
    ]
}