msgid "Reset password"
msgstr "パスワードをリセット"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:42
msgid "Set password"
msgstr "パスワードを設定"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:85
msgid "The two password fields didn’t match."
msgstr "確認用パスワードが一致しません。"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:89
#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:277
#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:313
msgid "Password"
msgstr "パスワード"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:89
msgid "Password confirmation"
msgstr "パスワード(確認用)"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:102
msgid "Enter the same password as before, for verification."
msgstr "確認のため、再度パスワードを入力してください。"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:149
msgid ""
"Whether the user will be able to authenticate using a password or not. If "
"disabled, they may still be able to authenticate using other backends, such "
"as Single Sign-On or LDAP."
msgstr ""
"ユーザーがパスワードを使用して認証できるかどうか。無効にしても、シングルサイ"
"ンオンや LDAP などの他のバックエンドを使用して認証できる可能性があります。"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:157
msgid "Password-based authentication"
msgstr "パスワードによる認証"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:160
msgid "Enabled"
msgstr "有効"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:160
msgid "Disabled"
msgstr "無効"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:279
msgid ""
"Raw passwords are not stored, so there is no way to see the user’s password."
msgstr ""
"パスワードは平文では保存されず、ユーザーのパスワードを見る方法もありません。"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:295
msgid ""
"Enable password-based authentication for this user by setting a password."
msgstr "パスワードを設定し、このユーザーでパスワードによる認証を有効にします。"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:320
#, python-format
msgid ""
"Please enter a correct %(username)s and password. Note that both fields may "
"be case-sensitive."
msgstr ""
"正しい%(username)sとパスワードを入力してください。どちらのフィールドも大文字"
"と小文字は区別されます。"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:323
msgid "This account is inactive."
msgstr "アカウントが無効です。"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:389
msgid "Email"
msgstr "メールアドレス"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:498
msgid "New password"
msgstr "新しいパスワード"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:498
msgid "New password confirmation"
msgstr "新しいパスワード(確認用)"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:523
msgid "Your old password was entered incorrectly. Please enter it again."
msgstr "元のパスワードが間違っています。もう一度入力してください。"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:527
msgid "Old password"
msgstr "元のパスワード"

