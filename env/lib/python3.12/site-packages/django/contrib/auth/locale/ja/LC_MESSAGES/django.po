msgstr "登録日"

#: env/lib/python3.12/site-packages/django/contrib/auth/models.py:493
msgid "user"
msgstr "ユーザー"

#: env/lib/python3.12/site-packages/django/contrib/auth/models.py:494
msgid "users"
msgstr "ユーザー"

#: env/lib/python3.12/site-packages/django/contrib/auth/password_validation.py:118
#, python-format
msgid "This password is too short. It must contain at least %d character."
msgid_plural ""
"This password is too short. It must contain at least %d characters."
msgstr[0] "このパスワードは短すぎます。最低 %d 文字以上必要です。"

#: env/lib/python3.12/site-packages/django/contrib/auth/password_validation.py:127
#, python-format
msgid "Your password must contain at least %(min_length)d character."
msgid_plural "Your password must contain at least %(min_length)d characters."
msgstr[0] "パスワードは最低 %(min_length)d 文字以上必要です。"

#: env/lib/python3.12/site-packages/django/contrib/auth/password_validation.py:216
#, python-format
msgid "The password is too similar to the %(verbose_name)s."
msgstr "このパスワードは %(verbose_name)s と似すぎています。"

#: env/lib/python3.12/site-packages/django/contrib/auth/password_validation.py:220
msgid "Your password can’t be too similar to your other personal information."
msgstr "あなたの他の個人情報と似ているパスワードにはできません。"

#: env/lib/python3.12/site-packages/django/contrib/auth/password_validation.py:258
msgid "This password is too common."
msgstr "このパスワードは一般的すぎます。"

#: env/lib/python3.12/site-packages/django/contrib/auth/password_validation.py:261
msgid "Your password can’t be a commonly used password."
msgstr "よく使われるパスワードにはできません。"

#: env/lib/python3.12/site-packages/django/contrib/auth/password_validation.py:277
msgid "This password is entirely numeric."
msgstr "このパスワードは数字しか使われていません。"

#: env/lib/python3.12/site-packages/django/contrib/auth/password_validation.py:280
msgid "Your password can’t be entirely numeric."
msgstr "数字だけのパスワードにはできません。"

#: env/lib/python3.12/site-packages/django/contrib/auth/templates/registration/password_reset_subject.txt:2
#, python-format
msgid "Password reset on %(site_name)s"
msgstr "%(site_name)s のパスワードリセット"

#: env/lib/python3.12/site-packages/django/contrib/auth/templatetags/auth.py:12
msgid "No password set."
msgstr "パスワードは設定されませんでした。"

#: env/lib/python3.12/site-packages/django/contrib/auth/templatetags/auth.py:19
msgid "Invalid password format or unknown hashing algorithm."
msgstr "無効なパスワードか不明なハッシュアルゴリズムです。"

#: env/lib/python3.12/site-packages/django/contrib/auth/validators.py:12
msgid ""
"Enter a valid username. This value may contain only unaccented lowercase a-z "
"and uppercase A-Z letters, numbers, and @/./+/-/_ characters."
msgstr ""
"有効なユーザー名を入力してください。アクセント記号を除いた半角英数、 @/./+/-/"
"_ を使用できます。"

#: env/lib/python3.12/site-packages/django/contrib/auth/validators.py:22
msgid ""
"Enter a valid username. This value may contain only letters, numbers, and "
"@/./+/-/_ characters."
msgstr ""
"有効なユーザー名を入力してください。半角英数、 @/./+/-/_ を使用できます。"

#: env/lib/python3.12/site-packages/django/contrib/auth/views.py:160
msgid "Logged out"
msgstr "ログアウト"

#: env/lib/python3.12/site-packages/django/contrib/auth/views.py:220
msgid "Password reset"
msgstr "パスワードをリセット"

#: env/lib/python3.12/site-packages/django/contrib/auth/views.py:244
msgid "Password reset sent"
msgstr "パスワードリセットを送信しました"

#: env/lib/python3.12/site-packages/django/contrib/auth/views.py:257
msgid "Enter new password"
msgstr "新しいパスワードを入力してください"

#: env/lib/python3.12/site-packages/django/contrib/auth/views.py:328
msgid "Password reset unsuccessful"
msgstr "パスワードのリセットに失敗しました"

#: env/lib/python3.12/site-packages/django/contrib/auth/views.py:338
msgid "Password reset complete"
msgstr "パスワードがリセットされました"

#: env/lib/python3.12/site-packages/django/contrib/auth/views.py:353
msgid "Password change"
msgstr "パスワードの変更"

#: env/lib/python3.12/site-packages/django/contrib/auth/views.py:371
msgid "Password change successful"
msgstr "パスワードを変更しました"
