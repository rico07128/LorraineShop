#, python-format
msgid "Change password: %s"
msgstr "パスワードの変更: %s"

#: env/lib/python3.12/site-packages/django/contrib/auth/admin.py:208
#, python-format
msgid "Set password: %s"
msgstr "パスワード設定: %s"

