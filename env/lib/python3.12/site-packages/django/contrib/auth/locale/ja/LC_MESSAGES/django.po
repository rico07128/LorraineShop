msgid "Authentication and Authorization"
msgstr "認証と認可"

#: env/lib/python3.12/site-packages/django/contrib/auth/base_user.py:44
msgid "password"
msgstr "パスワード"

#: env/lib/python3.12/site-packages/django/contrib/auth/base_user.py:45
msgid "last login"
msgstr "最終ログイン"

