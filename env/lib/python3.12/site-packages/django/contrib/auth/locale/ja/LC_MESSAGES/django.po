#: env/lib/python3.12/site-packages/django/contrib/auth/admin.py:46
msgid "Personal info"
msgstr "個人情報"

#: env/lib/python3.12/site-packages/django/contrib/auth/admin.py:48
msgid "Permissions"
msgstr "パーミッション"

#: env/lib/python3.12/site-packages/django/contrib/auth/admin.py:59
msgid "Important dates"
msgstr "重要な日程"

#: env/lib/python3.12/site-packages/django/contrib/auth/admin.py:156
#, python-format
msgid "%(name)s object with primary key %(key)r does not exist."
msgstr "主キーが %(key)r である %(name)s オブジェクトは存在しません。"

#: env/lib/python3.12/site-packages/django/contrib/auth/admin.py:175
msgid "Conflicting form data submitted. Please try again."
msgstr "送信されたフォームデータは競合しています。もう一度試してみてください。"

