#: env/lib/python3.12/site-packages/django/contrib/auth/models.py:130
msgid "group"
msgstr "グループ"

#: env/lib/python3.12/site-packages/django/contrib/auth/models.py:131
#: env/lib/python3.12/site-packages/django/contrib/auth/models.py:333
msgid "groups"
msgstr "グループ"

#: env/lib/python3.12/site-packages/django/contrib/auth/models.py:324
msgid "superuser status"
msgstr "スーパーユーザー権限"

#: env/lib/python3.12/site-packages/django/contrib/auth/models.py:327
msgid ""
"Designates that this user has all permissions without explicitly assigning "
"them."
msgstr "全ての権限を持っているとみなされます。"

#: env/lib/python3.12/site-packages/django/contrib/auth/models.py:336
msgid ""
"The groups this user belongs to. A user will get all permissions granted to "
"each of their groups."
msgstr ""
"このユーザーが所属するグループ。ユーザーはそれぞれのグループに付与されたすべ"
"ての権限を持ちます。"

#: env/lib/python3.12/site-packages/django/contrib/auth/models.py:344
msgid "user permissions"
msgstr "ユーザーパーミッション"

#: env/lib/python3.12/site-packages/django/contrib/auth/models.py:346
msgid "Specific permissions for this user."
msgstr "このユーザーの持つ権限です。"

#: env/lib/python3.12/site-packages/django/contrib/auth/models.py:457
msgid "username"
msgstr "ユーザー名"

#: env/lib/python3.12/site-packages/django/contrib/auth/models.py:461
msgid "Required. 150 characters or fewer. Letters, digits and @/./+/-/_ only."
msgstr ""
"この項目は必須です。半角アルファベット、半角数字、@/./+/-/_ で150文字以下にし"
"てください。"

#: env/lib/python3.12/site-packages/django/contrib/auth/models.py:465
msgid "A user with that username already exists."
msgstr "同じユーザー名が既に登録済みです。"

#: env/lib/python3.12/site-packages/django/contrib/auth/models.py:468
msgid "first name"
msgstr "名"

#: env/lib/python3.12/site-packages/django/contrib/auth/models.py:469
msgid "last name"
msgstr "姓"

#: env/lib/python3.12/site-packages/django/contrib/auth/models.py:470
msgid "email address"
msgstr "メールアドレス"

#: env/lib/python3.12/site-packages/django/contrib/auth/models.py:472
msgid "staff status"
msgstr "スタッフ権限"

#: env/lib/python3.12/site-packages/django/contrib/auth/models.py:474
msgid "Designates whether the user can log into this admin site."
msgstr "ユーザーが管理サイトにログイン可能かどうかを示します。"

#: env/lib/python3.12/site-packages/django/contrib/auth/models.py:477
msgid "active"
msgstr "有効"

#: env/lib/python3.12/site-packages/django/contrib/auth/models.py:480
msgid ""
"Designates whether this user should be treated as active. Unselect this "
"instead of deleting accounts."
msgstr ""
"ユーザーがアクティブかどうかを示します。アカウントを削除する代わりに選択を解"
"除してください。"

#: env/lib/python3.12/site-packages/django/contrib/auth/models.py:484
