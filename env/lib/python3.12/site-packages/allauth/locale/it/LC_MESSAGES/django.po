msgstr "Il tuo account non ha ancora nessuna password."

#: env/lib/python3.12/site-packages/allauth/socialaccount/adapter.py:36
msgid "Your account has no verified email address."
msgstr "Il tuo account non ha un indirizzo email verificato."

#: env/lib/python3.12/site-packages/allauth/socialaccount/adapter.py:38
msgid "You cannot disconnect your last remaining third-party account."
msgstr ""
