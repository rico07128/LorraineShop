msgstr "Token non valido."

#: env/lib/python3.12/site-packages/allauth/idp/oidc/internal/clientkit.py:39
msgid "Wildcards are only allowed in the hostname portion of the URI."
msgstr ""
"I caratteri jolly sono consentiti solo nella parte del nome host dell'URI."

