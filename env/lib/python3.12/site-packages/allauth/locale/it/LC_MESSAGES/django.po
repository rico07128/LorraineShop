#: env/lib/python3.12/site-packages/allauth/idp/oidc/internal/clientkit.py:22
msgid "Wildcards are not allowed unless 'Allow URI wildcards' is enabled."
msgstr ""
"I caratteri jolly non sono consentiti a meno che non sia abilitata l'opzione "
"'Consenti caratteri jolly negli URI'."

#: env/lib/python3.12/site-packages/allauth/idp/oidc/internal/clientkit.py:27
msgid ""
"URI '{}' contains more than one wildcard (*). Only one wildcard per URI is "
"allowed."
msgstr ""
"L'URI '{}' contiene più di un carattere jolly (*). È consentito un solo "
"carattere jolly per URI."

#: env/lib/python3.12/site-packages/allauth/idp/oidc/internal/clientkit.py:35
#, fuzzy, python-brace-format
#| msgid "Invalid token."
